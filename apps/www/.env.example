# Public URL of the API, called by the browser (exposed to the client)
VITE_API_URL=http://localhost:3001
# Optional: URL of the API used by the server during rendering, e.g. an internal
# address in production. Defaults to VITE_API_URL. Read from the process
# environment, not from this file.
# API_URL=
# Optional: "true" shows the theme menu outside development (e.g. on staging)
# VITE_THEME_SWITCHER=
