		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "~2.9.1",
		"@repo/config-ts": "workspace:*",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "catalog:",
