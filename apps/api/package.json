{
	"name": "api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsdown",
		"start": "node --env-file-if-exists=.env dist/index.mjs",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file=.env src/db/migrate.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.6",
		"@hono/zod-validator": "^0.9.1",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.17",
		"postgres": "^3.4.9",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config-ts": "workspace:*",
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11",
		"tsdown": "^0.23.7",
		"tsx": "^4.23.15",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
