NODE_ENV=development
PORT=3001
# Public URL of this API (used in sign-in links and OAuth callbacks)
API_URL=http://localhost:3001
# Public URL of the front end (used in invitation emails)
APP_URL=http://localhost:3000
# Local database started with `pnpm --filter api db:up`
DATABASE_URL=postgres://checkit:checkit@localhost:5433/checkit
# Comma-separated list of front-end origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Signs sessions and tokens: at least 32 characters, generate one with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Email sending with Resend (required in production, both or none). Without them,
# emails are printed to the console. API key with "Sending access", restricted
# to the sender's domain, verified in Resend (EU region)
# RESEND_API_KEY=
# EMAIL_FROM=Checkit <checkit@example.com>
# Parent domain shared by the API and the front end in production, e.g.
# checkit.example.com for api.checkit.example.com: shares the session cookie.
# Leave unset in development (both run on localhost)
# COOKIE_DOMAIN=
# Google sign-in (optional, both or none): OAuth client from Google Cloud Console,
# with the redirect URI <API_URL>/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Voice input transcription (optional), for browsers without speech recognition
# (Firefox): a Mistral API key. Without it, voice input only works where the
# browser recognizes speech itself
# MISTRAL_API_KEY=
