NODE_ENV=development
PORT=3001
# Public URL of this API (used in sign-in links and OAuth callbacks)
API_URL=http://localhost:3001
# Local database started with `pnpm --filter api db:up`
DATABASE_URL=postgres://checkit:checkit@localhost:5433/checkit
# Comma-separated list of front-end origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Signs sessions and tokens: at least 32 characters, generate one with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Google sign-in (optional, both or none): OAuth client from Google Cloud Console,
# with the redirect URI <API_URL>/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
